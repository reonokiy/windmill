# Copy to .env for local Bun debugging; never commit real credentials.
APP_ID=local-debug
# Optional; local storage works without configuration or B2 credentials.
BLOB_LOCAL_ROOT=.local/blobs

# Local equity Telegram notifications: mise run equity:local -- AAPL MSFT
FINNHUB_API_KEY=
# Full pi auth JSON; obtain it with mise run pi:login.
PI_AUTH_JSON=
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.3-codex
EQUITY_HORIZON=未来几天到几周

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
