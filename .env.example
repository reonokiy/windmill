# Copy to .env for local Bun debugging; never commit real credentials.
APP_ID=local-debug
# Optional; local storage works without configuration or B2 credentials.
BLOB_LOCAL_ROOT=.local/blobs

# Local equity Telegram notifications: mise run equity:local -- AAPL MSFT
FINNHUB_API_KEY=
# Keygate API key for https://api.nokiy.net/codex/v1 (Codex subscription gateway).
CODEX_API_KEY=
PI_PROVIDER=codex-gateway
PI_MODEL=gpt-6-luna
EQUITY_HORIZON=日内至下一个交易日，超短线

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
